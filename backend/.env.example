# Plantilla de configuración — SIN SECRETOS REALES (OWASP A02).
# Copiar a .env y completar. El .env real nunca entra al repositorio.

ENVIRONMENT=development
DEBUG=false

# Conexión de la app: rol factuchat_app, siempre sujeto a RLS
DATABASE_URL=postgresql+psycopg://factuchat_app:CAMBIAR@localhost:5433/factuchat
# Conexión de administración: solo migraciones y CLI, nunca la API
DATABASE_URL_ADMIN=postgresql+psycopg://factuchat:CAMBIAR@localhost:5433/factuchat

REDIS_URL=redis://localhost:6380/0

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Clave AES-256-GCM para secretos TOTP (32 bytes en base64).
# Generar con: python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
TOTP_ENC_KEY=
# Clave maestra AES-256-GCM para los certificados .p12 y sus contraseñas (fase 2).
# Misma forma de generarla. Rotarla exige recifrar los certificados guardados.
CERT_ENC_KEY=

# Dominio definitivo (factuchat.ai o factuchat.ec) — pendiente de confirmación
APP_DOMAIN=
# Datos públicos de la landing (fase 6.2). Los correos vacíos se derivan de
# APP_DOMAIN (info@ y ventas@). El resto trae los valores de la maqueta: se
# descomentan solo para cambiarlos, porque un valor VACÍO aquí sí pisa el
# predeterminado y dejaría la web sin teléfono ni cuentas de cobro.
# CONTACTO_EMAIL=
# CONTACTO_EMAIL_VENTAS=
# CONTACTO_TELEFONO=099 337 1891
# CONTACTO_TELEFONO_E164=+593993371891
# COBRO_TITULAR=
# COBRO_TITULAR_IDENTIFICACION=
# Cuentas donde se recibe la transferencia del checkout: "Banco|número", en JSON
# COBRO_CUENTAS=["Banco Pichincha|2203135848","Banco Guayaquil|14919843"]
# --- Buzón SRI (fase 7) ---
# Interruptor global del módulo. Nace apagado; el superadmin puede encenderlo
# desde el panel y ese cambio, que queda auditado, pisa a este valor.
BUZON_ACTIVO=false
# Dominio de las direcciones {ruc}@… Vacío = se deriva de APP_DOMAIN.
BUZON_DOMINIO=
# 32 bytes en base64, DISTINTA de CERT_ENC_KEY: el radio de daño de la firma
# electrónica no debe ampliarse a los documentos del buzón, y cada una se rota
# por su cuenta. Generar con: openssl rand -base64 32
BUZON_ENC_KEY=
# Firma HMAC-SHA256 del webhook de correo entrante. Sin este secreto el webhook
# rechaza todo: un buzón sin firma acepta documentos de cualquiera, y esos
# documentos cambian la declaración de impuestos de un cliente.
BUZON_WEBHOOK_SECRET=
# Alternativa al webhook: recolección por IMAP para despliegue propio.
BUZON_IMAP_HOST=
BUZON_IMAP_USER=
BUZON_IMAP_PASSWORD=

# Correo saliente (RIDE al cliente final). Vacío = modo outbox de desarrollo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Archivos generados (XML firmados, RIDE)
STORAGE_DIR=var/storage
EMAIL_OUTBOX_DIR=var/outbox

# --- WhatsApp Cloud API de Meta (fase 5) ---
# WA_APP_SECRET firma cada webhook: SIN ella el webhook rechaza todo, nunca
# falla abierto. Se saca de la configuración de la app en Meta for Developers.
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0
# Tope mensual de gasto en conversaciones (0 = sin tope) y umbral de aviso
WA_PRESUPUESTO_MENSUAL=0
WA_ALERTA_PCT=80

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

SENTRY_DSN=
CORS_ORIGINS=["http://localhost:5173"]
