# Entornos y secretos — NUNCA subir .env reales (OWASP A02)
.env
.env.*
!.env.example
# Sin punto: un "env" suelto es igual de peligroso y el patrón de arriba no lo cubre
env
deploy/env

# Binarios sueltos: un instalador arrastrado aquí por error pesa cientos de MB y
# sacarlo del historial luego exige reescribirlo
*.exe
*.msi
*.p12
*.pem
*.key

# Datos de ejecución — NUNCA al repo (facturas, buzón SRI, comprobantes)
backend/var/
var/storage/
storage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
*.egg-info/

# Node
node_modules/
frontend/dist/
*.tsbuildinfo

# IDE / SO
.vscode/
.idea/
Thumbs.db
.DS_Store
desktop.ini

