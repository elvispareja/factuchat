# Plantilla del .env de PRODUCCIÓN — SIN SECRETOS REALES (OWASP A02).
#
# Copiar a `deploy/.env` en el servidor y completar. El .env real:
#   · NUNCA entra al repositorio (está en .gitignore),
#   · lleva permisos 600 y propiedad root  →  chown root:root .env && chmod 600 .env
#   · NO se incluye en los respaldos. Si un respaldo llevara los secretos dentro,
#     cada copia sería el compromiso completo del sistema. Ver
#     docs/procedimiento-respaldo-restauracion.md.
#
# Este fichero cubre TANTO las variables de la aplicación (las mismas de
# backend/.env.example) COMO las de la infraestructura de docker-compose.
# Ante la duda sobre una variable de la aplicación, la referencia es
# backend/app/core/config.py, que las declara todas con su valor por defecto.

# =====================================================================
# INFRAESTRUCTURA (solo producción)
# =====================================================================

# Dominio del servicio. nginx lo sustituye en sus bloques `server` al arrancar
# y certbot emite el certificado para él. PENDIENTE DE CONFIRMAR: las maquetas
# usan tres distintos (factuchat.ai en los correos, factuchat.ec en el pie,
# factuchat.com en las direcciones de buzón). Debe coincidir con APP_DOMAIN.
FACTUCHAT_DOMINIO=

# Etiqueta de la imagen del backend que se despliega. Se usa para poder volver
# a la versión anterior sin reconstruir.
FACTUCHAT_VERSION=latest

# Correo al que Let's Encrypt avisa si un certificado va a caducar sin renovarse.
CERTBOT_EMAIL=

# Imágenes base. HOY van por ETIQUETA, que es lo que se ve abajo; FIJARLAS POR
# DIGEST está PENDIENTE (OWASP A03) y hay que hacerlo antes del despliegue: una
# etiqueta como `postgres:16` cambia de contenido sin avisar, el digest no.
# Para obtener el digest actual y reemplazar el valor:
#   docker pull postgres:16
#   docker inspect --format='{{index .RepoDigests 0}}' postgres:16
#   # queda: POSTGRES_IMAGE=postgres@sha256:...
# Y antes de subirlo a producción:
#   trivy image --severity HIGH,CRITICAL <imagen@digest>
NGINX_IMAGE=nginx:1.27-alpine
CERTBOT_IMAGE=certbot/certbot:latest
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7-alpine

# --- PostgreSQL -------------------------------------------------------
# Credenciales del SUPERUSUARIO del contenedor. Solo se usa para migraciones y
# CLI; la aplicación nunca se conecta con este rol.
POSTGRES_USER=factuchat
POSTGRES_PASSWORD=
POSTGRES_DB=factuchat
# Contraseña del rol factuchat_app, que es el que usa la aplicación y está
# sujeto a RLS (NOBYPASSRLS). La crea deploy/postgres/init/01-roles.sh la
# primera vez que arranca el cluster.
APP_DB_PASSWORD=

# --- Redis ------------------------------------------------------------
# Redis vive solo en la red interna, pero va con contraseña igualmente: si
# algún día quedara expuesto por error, un Redis abierto es acceso directo a
# la cola de tareas.
REDIS_PASSWORD=

# =====================================================================
# APLICACIÓN
# =====================================================================

ENVIRONMENT=production
DEBUG=false

# Los tres roles, cada uno con su conexión. Los nombres de host son los de los
# servicios del compose, que solo resuelven dentro de la red interna.
DATABASE_URL=postgresql+psycopg://factuchat_app:${APP_DB_PASSWORD}@postgres:5432/factuchat
DATABASE_URL_ADMIN=postgresql+psycopg://factuchat:${POSTGRES_PASSWORD}@postgres:5432/factuchat
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# --- Secretos ---------------------------------------------------------
# En producción el arranque FALLA si alguno de estos falta o trae un valor de
# desarrollo (backend/app/core/config.py, sin_valores_inseguros_en_produccion).
#
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# openssl rand -base64 32   (32 bytes en base64, una clave por dominio de uso)
TOTP_ENC_KEY=
# Certificados .p12 de firma. PERDERLA es irrecuperable: cada inquilino tendría
# que volver a subir el suyo. Ver docs/plan-de-continuidad.md.
CERT_ENC_KEY=
# Correos y XML del buzón. Distinta de CERT_ENC_KEY a propósito: el radio de
# daño de la firma electrónica no debe ampliarse a los documentos de terceros.
BUZON_ENC_KEY=

# Debe coincidir con FACTUCHAT_DOMINIO. Obligatorio en producción.
APP_DOMAIN=
CORS_ORIGINS=["https://CAMBIAR"]

# --- Correo saliente --------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- WhatsApp (Meta) --------------------------------------------------
# Sin WA_APP_SECRET el webhook rechaza todo: nunca falla abierto.
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_PRESUPUESTO_MENSUAL=0
WA_ALERTA_PCT=80

# --- Buzón SRI --------------------------------------------------------
# Nace apagado. El superadmin lo enciende desde el panel y ese cambio, que
# queda auditado, pisa a este valor.
BUZON_ACTIVO=false
BUZON_DOMINIO=
# Firma del webhook de correo entrante. Con BUZON_ACTIVO=true, el arranque
# exige este secreto o BUZON_IMAP_HOST.
BUZON_WEBHOOK_SECRET=
BUZON_IMAP_HOST=
BUZON_IMAP_USER=
BUZON_IMAP_PASSWORD=

# --- Datos públicos de la landing -------------------------------------
# Vacíos = se derivan de APP_DOMAIN. Un valor vacío en los demás SÍ pisa el
# predeterminado, así que se descomentan solo para cambiarlos.
# CONTACTO_EMAIL=
# CONTACTO_EMAIL_VENTAS=
# CONTACTO_TELEFONO=099 337 1891
# CONTACTO_TELEFONO_E164=+593993371891
# COBRO_TITULAR=
# COBRO_TITULAR_IDENTIFICACION=
# COBRO_CUENTAS=["Banco Pichincha|2203135848"]

# --- Observabilidad y sesiones ----------------------------------------
# Sentry va con filtro de secretos y sin variables locales (el .p12 descifrado
# vivía ahí). Ver backend/app/core/observabilidad.py.
SENTRY_DSN=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

STORAGE_DIR=/var/factuchat/storage
